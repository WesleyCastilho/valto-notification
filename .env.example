PORT=8080
MODE=all
DELIVERY_ENABLED=false
SEND_INTERVAL=1s
# Local development only; production must point to the actual Valto database.
DATABASE_URL=postgres://valto:local-development-only@db:5432/valto?sslmode=disable
POSTGRES_PASSWORD=local-development-only
EVOLUTION_API_URL=https://evolution.rigora.com.br
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=Valto
# Optional. Defaults to bunker.
# CLIENT_ID=bunker
# Optional. Defaults to the existing EVOLUTION_API_KEY; no additional key is required.
# VALTO_API_KEY=
